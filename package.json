{
  "name": "pi-video-studio",
  "version": "0.2.0-alpha.55",
  "private": true,
  "description": "Pi Studio для macOS — локальные проекты и конструктор агентов",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.ts --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run typecheck && electron-vite build",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "test:desktop": "npm run build && electron scripts/smoke-electron.cjs",
    "test:video": "npm run build && electron scripts/smoke-video.cjs",
    "test:library": "npm run build && electron scripts/smoke-library.cjs",
    "test:character-rig": "npm run build && electron scripts/smoke-character-rig.cjs",
    "test:connections": "npm run build && electron scripts/smoke-connections.cjs",
    "test:launch-configuration": "npm run build && electron scripts/smoke-launch-configuration.cjs",
    "test:pi-current-model": "node --experimental-strip-types scripts/smoke-pi-current-model.ts",
    "test:pi-project-moves": "node --experimental-strip-types scripts/smoke-pi-project-moves.ts",
    "test:project-moves": "npm run build && electron scripts/smoke-project-moves.cjs",
    "test:images": "npm run build && electron scripts/smoke-image-settings.cjs",
    "test:pi-images": "node --experimental-strip-types scripts/smoke-pi-images.ts",
    "test:pi-library": "node --experimental-strip-types scripts/smoke-pi-session.ts --library",
    "test:pi-library-agents": "node --experimental-strip-types scripts/smoke-pi-library-agents.ts",
    "test:system-agents": "npm run build && electron scripts/smoke-system-agents.cjs",
    "test:pi-setup": "node --experimental-strip-types scripts/smoke-pi-setup.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src electron.vite.config.ts vite.config.ts",
    "test:startup": "npm run build && electron scripts/smoke-startup.cjs",
    "test:fresh-startup": "node scripts/smoke-fresh-startup.cjs",
    "test:pi-install": "node --experimental-strip-types scripts/smoke-pi-install.ts",
    "test:pi-auth": "node --experimental-strip-types scripts/smoke-pi-auth.ts",
    "test:pi-session": "node --experimental-strip-types scripts/smoke-pi-session.ts",
    "test:tooltips": "npm run build && electron scripts/smoke-tooltips.cjs",
    "test:pi-chain": "node --experimental-strip-types scripts/smoke-pi-chain.ts",
    "test:pi-chain-local": "node --experimental-strip-types scripts/smoke-pi-chain-local.ts",
    "test:mcp-secrets": "npm run build && electron scripts/smoke-mcp-secrets.cjs",
    "test:pi-mcp-secrets": "node --experimental-strip-types scripts/smoke-pi-mcp-secrets.ts",
    "test:pi-image-references": "node --experimental-strip-types scripts/smoke-pi-images.ts --references",
    "test:pi-film": "node --experimental-strip-types scripts/smoke-pi-film.ts",
    "test:film-viewer": "npm run build && electron scripts/smoke-film-viewer.cjs",
    "test:mcp-oauth": "node --experimental-strip-types scripts/smoke-mcp-oauth.ts",
    "test:mcp-oauth-ui": "npm run build && electron scripts/smoke-mcp-oauth-ui.cjs",
    "test:stereo": "npm run build && electron scripts/smoke-video.cjs --stereo",
    "test:projects-list": "npm run build && electron scripts/smoke-projects-list.cjs",
    "test:disclosures": "npm run build && electron scripts/smoke-disclosure-list.cjs",
    "test:pi-connections": "node --experimental-strip-types scripts/smoke-pi-connections.ts",
    "test:endpoints": "npm run build && electron scripts/smoke-endpoints.cjs",
    "test:pi-endpoints": "node --experimental-strip-types scripts/smoke-pi-endpoints.ts",
    "test:library-assignments": "npm run build && electron scripts/smoke-library-assignments.cjs",
    "test:clear-output": "npm run build && electron scripts/smoke-clear-output.cjs",
    "test:native-bundle": "npm run build && electron scripts/smoke-native-bundle.cjs",
    "test:persistence": "npm run build && electron scripts/smoke-persistence.cjs",
    "test:agent-constructor": "npm run build && node scripts/smoke-agent-constructor.cjs",
    "test:file-previews": "npm run build && electron scripts/smoke-file-previews.cjs",
    "test:fields": "npm run build && electron scripts/smoke-fields.cjs",
    "test:pi-reasoning": "node --experimental-strip-types scripts/smoke-pi-reasoning.ts",
    "test:reasoning-ui": "npm run build && electron scripts/smoke-reasoning-ui.cjs",
    "test:library-render": "electron scripts/smoke-library-render.cjs",
    "test:pi-parallel": "node --experimental-strip-types scripts/smoke-pi-parallel.ts",
    "test:model-catalog": "node --experimental-strip-types scripts/smoke-model-catalog.ts",
    "test:first-message": "npm run build && electron scripts/smoke-first-message.cjs",
    "test:quit-cancel": "npm run build && electron scripts/smoke-quit-cancel.cjs",
    "test:pi-attachments": "node --experimental-strip-types scripts/smoke-pi-attachments.ts",
    "test:image-status": "npm run build && electron scripts/smoke-image-status.cjs",
    "test:browser": "node --experimental-strip-types scripts/smoke-browser.mjs",
    "test:pi-browser": "node --experimental-strip-types scripts/smoke-pi-browser.ts",
    "test:browser-ui": "npm run build && electron scripts/smoke-browser-ui.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@remotion/media": "4.0.543",
    "@remotion/player": "4.0.543",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remotion": "4.0.543",
    "saxes": "6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.3.1",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
